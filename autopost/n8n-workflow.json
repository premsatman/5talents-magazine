{
  "name": "5Talents — auto post to X + Facebook",
  "settings": { "timezone": "Asia/Kolkata", "executionOrder": "v1" },
  "nodes": [
    { "id": "trg", "name": "Daily 6 AM IST", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-200, 300],
      "parameters": { "rule": { "interval": [ { "field": "days", "triggerAtHour": 6, "triggerAtMinute": 0 } ] } } },
    { "id": "cfg", "name": "Config — set your IDs here", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [20, 300],
      "parameters": { "assignments": { "assignments": [
        { "id": "a1", "name": "xAccountId", "type": "string", "value": "PASTE_ZERNIO_X_ACCOUNT_ID" },
        { "id": "a2", "name": "fbAccountId", "type": "string", "value": "PASTE_ZERNIO_FACEBOOK_PAGE_ACCOUNT_ID" },
        { "id": "a3", "name": "today", "type": "string", "value": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd') }}" } ] }, "options": {} } },
    { "id": "read", "name": "Get today's row from Notion", "type": "n8n-nodes-base.notion", "typeVersion": 3, "position": [240, 300],
      "parameters": { "resource": "databasePage", "operation": "getAll",
        "dataSourceId": { "__rl": true, "value": "291377c0-779a-411f-bc77-c903620fb21a", "mode": "id" },
        "returnAll": true, "filterType": "manual", "matchType": "allFilters",
        "filters": { "conditions": [
          { "key": "Date|date", "condition": "equals", "date": "={{ $json.today }}" },
          { "key": "Status|select", "condition": "equals", "selectValue": "To post" } ] }, "options": {} } },
    { "id": "guard", "name": "Anything to post?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [460, 300],
      "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
        "conditions": [ { "id": "c1", "leftValue": "={{ $json.property_x_post }}", "rightValue": "",
          "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } } ], "combinator": "and" }, "options": {} } },
    { "id": "build", "name": "Build post payloads", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [680, 220],
      "parameters": { "assignments": { "assignments": [
        { "id": "b1", "name": "pageId", "type": "string", "value": "={{ $json.id }}" },
        { "id": "b2", "name": "headline", "type": "string", "value": "={{ $json.property_headline }}" },
        { "id": "b3", "name": "xText", "type": "string", "value": "={{ $json.property_x_post }}" },
        { "id": "b4", "name": "fbText", "type": "string", "value": "={{ $json.property_fb_post }}" },
        { "id": "b5", "name": "xAccountId", "type": "string", "value": "={{ $('Config — set your IDs here').first().json.xAccountId }}" },
        { "id": "b6", "name": "fbAccountId", "type": "string", "value": "={{ $('Config — set your IDs here').first().json.fbAccountId }}" },
        { "id": "b7", "name": "xTime", "type": "string", "value": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd') }}T09:00:00" },
        { "id": "b8", "name": "fbTime", "type": "string", "value": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd') }}T19:00:00" } ] }, "options": {} } },
    { "id": "postx", "name": "Schedule X post (9 AM)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [900, 140],
      "onError": "continueRegularOutput",
      "parameters": { "method": "POST", "url": "https://zernio.com/api/v1/posts",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.xText, scheduledFor: $json.xTime, timezone: 'Asia/Kolkata', platforms: [ { platform: 'twitter', accountId: $json.xAccountId } ] }) }}",
        "options": {} } },
    { "id": "postfb", "name": "Schedule Facebook post (7 PM)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [900, 320],
      "onError": "continueRegularOutput",
      "parameters": { "method": "POST", "url": "https://zernio.com/api/v1/posts",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Build post payloads').first().json.fbText, scheduledFor: $('Build post payloads').first().json.fbTime, timezone: 'Asia/Kolkata', platforms: [ { platform: 'facebook', accountId: $('Build post payloads').first().json.fbAccountId } ] }) }}",
        "options": {} } },
    { "id": "mark", "name": "Mark Posted in Notion", "type": "n8n-nodes-base.notion", "typeVersion": 3, "position": [1120, 320],
      "parameters": { "resource": "databasePage", "operation": "update",
        "pageId": { "__rl": true, "value": "={{ $('Build post payloads').first().json.pageId }}", "mode": "id" },
        "propertiesUi": { "propertyValues": [ { "key": "Status|select", "selectValue": "Posted" } ] }, "options": {} } },
    { "id": "noop", "name": "Nothing scheduled today", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [680, 420], "parameters": {} }
  ],
  "connections": {
    "Daily 6 AM IST": { "main": [ [ { "node": "Config — set your IDs here", "type": "main", "index": 0 } ] ] },
    "Config — set your IDs here": { "main": [ [ { "node": "Get today's row from Notion", "type": "main", "index": 0 } ] ] },
    "Get today's row from Notion": { "main": [ [ { "node": "Anything to post?", "type": "main", "index": 0 } ] ] },
    "Anything to post?": { "main": [ [ { "node": "Build post payloads", "type": "main", "index": 0 } ], [ { "node": "Nothing scheduled today", "type": "main", "index": 0 } ] ] },
    "Build post payloads": { "main": [ [ { "node": "Schedule X post (9 AM)", "type": "main", "index": 0 } ] ] },
    "Schedule X post (9 AM)": { "main": [ [ { "node": "Schedule Facebook post (7 PM)", "type": "main", "index": 0 } ] ] },
    "Schedule Facebook post (7 PM)": { "main": [ [ { "node": "Mark Posted in Notion", "type": "main", "index": 0 } ] ] }
  }
}
