# Sanity ------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="wdzgdrz5"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-27"

# Viewer/read token. Powers the Live Content API and draft mode.
SANITY_API_READ_TOKEN=""

# Editor/write token. ONLY used server-side by /api/submit to create drafts.
# Never expose this to the browser.
SANITY_API_WRITE_TOKEN=""

# Shared secret for the Sanity webhook -> /api/revalidate handler.
SANITY_REVALIDATE_SECRET=""

# Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Analytics ---------------------------------------------------------------
# GA4 Measurement ID, "G-" followed by ten characters. Leave blank until the
# property exists — with no ID the tag never loads and nothing breaks.
#
# The tag also requires VERCEL_ENV=production, so setting this locally or on a
# preview deployment still sends nothing. That is deliberate: see
# src/components/Analytics.tsx.
NEXT_PUBLIC_GA_ID=""

# Newsletter (Resend). See blueprint trigger 3 - test the daily send cap first.
# The API key is the only one required. Resend moved to a global Contacts model
# and a contact needs no list to exist, so both ids below are optional:
#   SEGMENT  internal organisation. Set it when there is more than one list
#   TOPIC    what a reader sees on the preference page. Set it when there is
#            more than one kind of email, so unsubscribing is not all-or-nothing
RESEND_API_KEY=""
RESEND_SEGMENT_ID=""
RESEND_TOPIC_ID=""

# Spam defence on the submission form. Leave blank to run honeypot-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Advertising. Leave blank until AdSense is approved - slots render nothing.
NEXT_PUBLIC_ADSENSE_CLIENT=""
