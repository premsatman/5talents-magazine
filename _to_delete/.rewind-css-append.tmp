
/* ==========================================================================
   5Talents Rewind - /rewind, episode pages, homepage block, article card.
   Added 21 Oct 2026. Reuses .btn/.endcard-btn for buttons and .watchit-frame
   for the 16:9 player so the show looks like the rest of the magazine.
   ========================================================================== */
.rewind-kicker {
  font-family: var(--font-sans); font-size: 0.74rem; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 var(--s-2);
}
.rewind-kicker a { text-decoration: none; color: var(--ink); }
.rewind-tagline { font-family: var(--font-serif); font-style: italic; font-size: var(--step-1); margin: 0 0 var(--s-3) !important; color: var(--ink) !important; }

.rewind-head { display: grid; gap: var(--s-5); align-items: start; }
@media (min-width: 760px) { .rewind-head { grid-template-columns: 240px 1fr; } }
.rewind-cover { width: 100%; max-width: 240px; height: auto; border: 1px solid var(--rule); }

.listenon { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin: var(--s-4) 0 0; }
.listenon--compact { margin-top: var(--s-2); }
.listenon__rss { font-family: var(--font-sans); font-size: 0.8rem; text-decoration: underline; color: var(--ink-secondary); }

.rewind-thumb { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--inverse-bg); }
.rewind-thumb--empty { border: 1px dashed var(--rule-strong); }

.episoderows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
.episoderow { display: grid; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: 1px solid var(--rule); }
@media (min-width: 640px) { .episoderow { grid-template-columns: 280px 1fr; } }
.episoderow__media { display: block; }
.episoderow__title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.05; margin: 0 0 var(--s-2); }
.episoderow__title a { text-decoration: none; }
.episoderow__summary { margin: 0; color: var(--ink-secondary); }

/* Homepage block */
.rewind-latest { display: grid; gap: var(--s-5); align-items: center; }
@media (min-width: 760px) { .rewind-latest { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); } }
.rewind-latest__media { position: relative; display: block; }
.rewind-play {
  position: absolute; left: var(--s-3); bottom: var(--s-3); width: 52px; height: 52px;
  display: grid; place-items: center; background: var(--highlight); color: var(--ink);
  font-size: 1.1rem; border-radius: 50%;
}
.rewind-latest__title { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; margin: 0 0 var(--s-3); }
.rewind-latest__title a { text-decoration: none; }

/* Episode page */
.episode { padding-top: var(--s-6); padding-bottom: var(--s-7); }
.episode__title { font-family: var(--font-display); font-size: var(--step-4); line-height: var(--display-leading); margin: 0 0 var(--s-3); text-wrap: balance; }
.episode__summary { font-family: var(--font-serif); font-style: italic; font-size: var(--step-1); margin: 0 0 var(--s-5); color: var(--ink-secondary); }
.episode-video { margin: 0 0 var(--s-5); }
.episode-chapters h2, .episode-audio h2, .episode-shorts h2, .episode-transcript h2 {
  font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 var(--s-3);
}
.episode-chapters ol { list-style: none; margin: 0 0 var(--s-6); padding: 0; border-top: 2px solid var(--ink); }
.episode-chapters li { display: grid; grid-template-columns: 4.2rem 1fr; gap: var(--s-3); padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
.episode-chapters__time {
  font-family: var(--font-sans); font-variant-numeric: tabular-nums; font-weight: 600; font-size: 0.85rem;
  background: var(--highlight); color: var(--ink); text-decoration: none; padding: 2px 8px; height: fit-content; justify-self: start;
}
.episode-chapters__title { margin: 0; font-weight: 600; }
.episode-chapters__read { margin: 4px 0 0; font-size: 0.92rem; color: var(--ink-secondary); }
.episode-audio { margin: 0 0 var(--s-5); padding: var(--s-4); border: 1px solid var(--rule); border-left: 4px solid var(--highlight-deep); }
.episode-audio audio { width: 100%; }
.episode-audio .note { margin: var(--s-2) 0 0; }
.episode-follow { margin: 0 0 var(--s-5); }
.episode-follow__head { font-family: var(--font-sans); font-weight: 600; margin: 0; }
.episode-shorts { margin: var(--s-6) 0; }
.episode-shorts ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
.episode-shorts__frame { position: relative; aspect-ratio: 9 / 16; background: #000; }
.episode-shorts__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.episode-transcript { margin: var(--s-6) 0 var(--s-4); border-top: 2px solid var(--ink); padding-top: var(--s-3); }
.episode-transcript summary { cursor: pointer; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-3); }
.episode-transcript summary h2 { display: inline; margin: 0; }
.episode-transcript p { font-family: var(--font-serif); font-size: var(--step-0); line-height: 1.6; }
.episode-transcript__at { font-family: var(--font-sans); font-size: 0.74rem; font-weight: 600; color: var(--ink-muted); margin-right: var(--s-2); font-variant-numeric: tabular-nums; }
.episode-credits { margin-top: var(--s-4); }
.episode-pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-top: var(--s-6); padding-top: var(--s-4); border-top: 2px solid var(--ink); }
.episode-pager a { display: grid; gap: 4px; text-decoration: none; font-weight: 600; }
.episode-pager__next { text-align: right; }

/* "Covered on 5Talents Rewind" at the foot of an article */
.onrewind { margin: var(--s-6) 0 0; padding: var(--s-4); background: var(--inverse-bg); color: var(--inverse-ink); }
.onrewind__item + .onrewind__item { margin-top: var(--s-4); padding-top: var(--s-4); border-top: 1px solid var(--inverse-rule); }
.onrewind__kicker { font-family: var(--font-sans); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--highlight); margin: 0 0 var(--s-2); }
.onrewind__title { font-family: var(--font-serif); font-size: var(--step-1); margin: 0; }
.onrewind__title a { color: var(--inverse-ink); text-decoration: none; }
.onrewind .btn { background: var(--highlight); color: var(--inverse-bg); border-color: var(--highlight); }
.onrewind .btn:hover { background: transparent; color: var(--highlight); }
.onrewind .listenon__rss { color: var(--inverse-muted); }
